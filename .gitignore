# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local run artifacts
dev-server.log
/verify-artifacts/

# launch drafts (local only)
/hackernews.md

# data archive (archive/, dagster/): crawls, the warehouse and local Dagster state stay local; the raw copies are
# in gs://museum-archive. data/taxonomy/*.csv (our own categories) is tracked.
/data/wikiart/
/data/museum.duckdb
/data/*.building.duckdb
/archive/.venv/
/dagster/.venv/
/dagster/home/*
!/dagster/home/dagster.yaml
__pycache__/
/data/wikidata/
/data/wikimedia/
# the narrator's recording sheets (python -m archive.guide sheet), generated
/data/guide/

# the site snapshot (archive/site.py), rebuilt from the ingest and the warehouse; deployed, not tracked (size)
/data/site/
/data/fingerprints/
