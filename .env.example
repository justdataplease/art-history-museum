# Copy to .env.local. Everything is optional: without any of it the app reads
# the bundled ingest snapshot in data/cache/museum.json.

# Postgres (e.g. Neon) for `npm run load-db` and, when set, all app reads.
DATABASE_URL=

# Identify yourself to the Wikimedia APIs when running the ingest scripts
# (https://meta.wikimedia.org/wiki/User-Agent_policy). The scripts (ingest,
# enrich, repair-data, fetch-music) read .env.local themselves.
WIKI_USER_AGENT="MyMuseum/1.0 (https://example.org; you@example.org)"

# ffmpeg with the native "aac" encoder, for `npm run fetch-music`.
# FFMPEG=/path/to/ffmpeg
